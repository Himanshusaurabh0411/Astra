# Copy to .env to configure TerraPulse. Blank feed URLs use the bundled data.
APP_ENV=development
TERRAPULSE_WEB_PORT=3000
TERRAPULSE_API_PORT=8000
INDIA_BBOX=68.0,6.5,97.5,37.5
RAINFALL_THRESHOLD_MM_HR=15.0
MAX_VECTOR_PAYLOAD_KB=100.0
DEFAULT_SCENARIO_MODE=NORMAL
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_DATA_PATH=

# Optional browser key restricted to the Maps JavaScript API and your origin.
# Rebuild the frontend after changing it. Leave blank for the bundled India map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# JSON array generated by python -m app.services.government_auth from backend/.
GOVERNMENT_ACCOUNTS=
# Exercise notifications go to this one address. A recipient alone enables Gmail drafts.
SOS_EMAIL_TO=personalhimanshu.0411@gmail.com
# Configure the sender to enable automatic email. Use starttls (usually 587) or ssl (usually 465).
SOS_EMAIL_FROM=
SOS_SMTP_HOST=
SOS_SMTP_PORT=587
SOS_SMTP_SECURITY=starttls
SOS_SMTP_USER=
SOS_SMTP_PASSWORD=
# The public Open-Meteo endpoint is for non-commercial use. Set a key for paid access.
OPEN_METEO_API_KEY=

# Configure authorized, machine-readable endpoints. Bearer tokens stay server-side.
# Sample paths may be files or directories and are resolved from backend/.
PORTAL_FETCH_TIMEOUT_SECONDS=3.0
MOSDAC_API_URL=
MOSDAC_API_TOKEN=
MOSDAC_SAMPLE_PATH=
BHOONIDHI_API_URL=
BHOONIDHI_API_TOKEN=
BHOONIDHI_SAMPLE_PATH=
VEDAS_API_URL=
VEDAS_API_TOKEN=
VEDAS_SAMPLE_PATH=
VEDAS_AGRI_SAMPLE_PATH=
BHUVAN_WFS_URL=
BHUVAN_API_TOKEN=1104f7577ce2f11b68c3f0ce0654d901e135134c
BHUVAN_SAMPLE_PATH=
BHUVAN_LULC_SAMPLE_PATH=

# Radio exercise settings
LORA_FREQUENCY_MHZ=865.2
LORA_BANDWIDTH_KHZ=125
MAX_MESH_HOPS=7
NAVIC_ENABLED=true
