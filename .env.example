# Hackathon API Configuration
# Copy this file to .env and fill in your actual keys. Never commit .env!

# LLM Providers (Fill based on your stack)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Backend / Database (e.g. Supabase, Firebase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App Settings
PORT=3000
NODE_ENV=development
