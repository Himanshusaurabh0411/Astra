# ==============================================================================
# TerraPulse Environment Configuration
# Space-to-Ground Geospatial Intelligence & Off-Grid Tactical Mesh
# ==============================================================================

# Application Environment
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Automated Early-Warning Thresholds
RAINFALL_THRESHOLD_MM_HR=15.0
MAX_VECTOR_PAYLOAD_KB=100.0
DEFAULT_SCENARIO_MODE=NORMAL

# Storage & Schema Resolution
# Optional overrides (default paths auto-resolve relative to backend directory)
SEED_DATA_PATH=app/data/seed_catchment.geojson
CONTRACTS_DIR=../contracts

# Tactical Mesh Radio Parameters (India ISM 865–867 MHz)
LORA_FREQUENCY_MHZ=865.2
LORA_BANDWIDTH_KHZ=125.0
MAX_MESH_HOPS=7
NAVIC_ENABLED=true
