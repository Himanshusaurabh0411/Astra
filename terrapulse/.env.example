# ==============================================================================
# TerraPulse Environment Configuration
# Space-to-Ground Geospatial Intelligence & Off-Grid Tactical Mesh
# ==============================================================================

# Application Environment
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Automated Early-Warning Thresholds
RAINFALL_THRESHOLD_MM_HR=15.0
MAX_VECTOR_PAYLOAD_KB=100.0
DEFAULT_SCENARIO_MODE=NORMAL

# Storage & Schema Resolution
# Optional overrides (default paths auto-resolve relative to backend directory)
SEED_DATA_PATH=app/data/seed_catchment.geojson
CONTRACTS_DIR=../contracts

# Real ISRO Earth Observation Portal Ingestion (MOSDAC, VEDAS, Bhoonidhi, Bhuvan)
# Set live URLs to fetch directly from ISRO portals, or point to local drop-in exports
MOSDAC_API_URL=
MOSDAC_SAMPLE_PATH=app/data/real_samples/mosdac/insat3ds_rainfall_hourly.json
VEDAS_API_URL=
VEDAS_SAMPLE_PATH=app/data/real_samples/vedas/cartosat_dem_roads_profile.json
VEDAS_AGRI_SAMPLE_PATH=app/data/real_samples/vedas/vedas_crop_phenology_sehore.json
BHOONIDHI_API_URL=
BHOONIDHI_SAMPLE_PATH=app/data/real_samples/bhoonidhi/eos04_sar_flood_stac.json
BHUVAN_WFS_URL=
BHUVAN_SAMPLE_PATH=app/data/real_samples/bhuvan/bhuvan_critical_infrastructure.geojson
BHUVAN_LULC_SAMPLE_PATH=app/data/real_samples/bhuvan/bhuvan_lulc_waterbodies.json

# Tactical Mesh Radio Parameters (India ISM 865–867 MHz)
LORA_FREQUENCY_MHZ=865.2
LORA_BANDWIDTH_KHZ=125.0
MAX_MESH_HOPS=7
NAVIC_ENABLED=true
